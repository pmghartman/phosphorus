# per host keys, written by the app or phosphorus on first start
.env

# runtime state, regenerated per host, not shipped
/state/

# forgejo data root and the bundled tailscaled's identity, see gitd/
/git/
/tailscale/

.DS_Store
*.bak

# the licence notices and SBOM, written by bun run licenses
/notices/

# bun's package cache, kept in the workspace by CI
/.bun-cache/

# the web build, rebuilt by bun run web in CI and the image
/packages/server/webstatic/dist/
/packages/server/webstatic/src/manifest.ts
# the web client's vendored copies
/apps/web/.vendor/
# installed JavaScript dependencies; keep dependency manifests and locks tracked
node_modules/
/phosphorus
/out/
/dist/
/packaging/host/payload/
/packaging/host/stage/
