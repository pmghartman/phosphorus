# per host keys, written by the app or phosphorus on first start
.env

# runtime state, regenerated per host, not shipped
/state/

# forgejo data root and the bundled tailscaled's identity, see gitd/
/git/
/tailscale/

.DS_Store
*.bak

# default [files] share, contents per host, not shipped
/files/*
!/files/.gitkeep

# go generate's web build, rebuilt in CI and the image
/internal/web/dist/*
!/internal/web/dist/README
/web/.vendor/
/phosphorus
