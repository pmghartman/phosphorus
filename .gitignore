# per host secrets, see .env.example
.env

# runtime state, regenerated per host, not shipped
/state/

# forgejo + litefs data root, see git/container/ and config/phosphorus.ini
/git/data/

.DS_Store
*.bak
node_modules/

# default [files] share, contents per host, not shipped
/files/*
!/files/.gitkeep

# generated per host from [files] in config/phosphorus.ini
/docker-compose.files.yml

# the model's gguf on the model host, not shipped
/models/
