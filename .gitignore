# per host secrets, see .env.example
.env

# runtime state, regenerated per host, not shipped
/state/

# forgejo + litefs data root, see container/git/ and config/phosphorus.ini
/git/data/

.DS_Store
*.bak

# default [files] share, contents per host, not shipped
/files/*
!/files/.gitkeep

# go generate's web build, rebuilt in CI and the image
/internal/web/dist/*
!/internal/web/dist/README
/web/.vendor/
/phosphorus
