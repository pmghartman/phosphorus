# copied to .env per host, never committed

# the mesh's domain and tunnel hostname, services under it by path or subdomain
BASE_DOMAIN=example.com

# cloudflare tunnel token, for a replica of the existing tunnel
TUNNEL_TOKEN=

# Tailscale auth key, expires every 90 days, see README
TS_AUTHKEY=

# Tailscale API access token, for the game split DNS nameservers kept in
# sync with the live hosts, expires every 90 days, see README
TS_API_KEY=

# the split DNS domain games are joined at, <name>.<zone>
GAME_ZONE=hesperus

# the mesh update's gate in the frontend, unset: the button open
HESPERUS_UPDATE_PASSWORD=
