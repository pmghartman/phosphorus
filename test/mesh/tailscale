#!/bin/sh
# a stand-in tailscale for the mesh test: $MESH_HOSTS lines of "name ip os",
# $MESH_SELF this host, a file down/<name> beside it marking a host offline
dir=$(dirname "$MESH_HOSTS")
case "$1 $2" in
  "status --json")
    awk -v self="$MESH_SELF" -v dir="$dir" '
      BEGIN { printf "{\"Peer\":{"; n = 0 }
      $1 == self { sip = $2; next }
      {
        online = (system("test -e " dir "/down/" $1) == 0) ? "false" : "true"
        printf "%s\"k%d\":{\"DNSName\":\"%s.mesh.ts.net.\",\"TailscaleIPs\":[\"%s\"],\"Online\":%s,\"OS\":\"%s\"}", (n++ ? "," : ""), n, $1, $2, online, $3
      }
      END { printf "},\"Self\":{\"DNSName\":\"%s.mesh.ts.net.\",\"TailscaleIPs\":[\"%s\"]}}\n", self, sip }
    ' "$MESH_HOSTS" ;;
  "ip -4")
    awk -v h="$3" '$1 == h { print $2; found = 1 } END { exit !found }' "$MESH_HOSTS" ;;
  *) echo "tailscale stand-in: $*" >&2; exit 1 ;;
esac
