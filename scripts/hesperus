#!/bin/bash
# hesperus: the cli with no args, else start / stop / restart / update, the cli
# in the hesperus container, the host needing nothing past docker
set -uo pipefail

# through the /usr/local/bin symlink to the checkout
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src == /* ]] || src="$d/$src"
done
DIR="$(cd -P "$(dirname "$src")/.." && pwd)"

usage() {
  echo "usage: hesperus              the cli: services, files, git, stats, model, mesh update"
  echo "       hesperus start        bring this host up (run-linux.sh / run-mac.sh)"
  echo "       hesperus stop         stop hesperus until the next hesperus start"
  echo "       hesperus restart      restart hesperus (and hesperus-git), picks up a host rename"
  echo "       hesperus update       update this host only"
  echo "       hesperus update all   update the whole mesh, one host at a time"
}

DOCKER=docker
[ "$(uname)" = Linux ] && ! docker info >/dev/null 2>&1 && DOCKER="sudo docker"

started() { $DOCKER inspect -f '{{.State.Running}} {{.State.StartedAt}}' hesperus 2>/dev/null; }

# a mesh update swaps this container out from under the cli: the new one
# waited for and reattached, on the same tab
cli() {
  local args=("$@") before code
  while :; do
    before="$(started)"
    if [ "${before%% *}" != true ]; then
      echo "hesperus isn't running, start it with: hesperus start" >&2
      exit 1
    fi
    $DOCKER exec -it -e TERM="${TERM:-xterm-256color}" -e COLORTERM -e COLORFGBG -e TERM_PROGRAM hesperus node /opt/frontend/cli/hesperus.js "${args[@]+"${args[@]}"}"
    code=$?
    [ "$(started)" = "$before" ] && exit "$code"
    echo "hesperus is restarting, reattaching (ctrl-c to quit)..."
    until [ "$(started | cut -d' ' -f1)" = true ]; do sleep 1; done
    [ "${args[0]:-}" = update-all ] && args=(--tab update)
  done
}

# HESPERUS_UPDATE_PASSWORD from .env, as the web and cli ask it, unset: open
ask_password() {
  local want got
  want="$(grep '^HESPERUS_UPDATE_PASSWORD=' "$DIR/.env" 2>/dev/null | cut -d= -f2-)"
  [ -n "$want" ] || return 0
  read -rsp "update password: " got; echo
  [ "$got" = "$want" ] || { echo "wrong password" >&2; exit 1; }
}

case "${1:-}|${2:-}" in
  "|") cli ;;
  start\|)
    case "$(uname)" in
      Darwin) exec bash "$DIR/scripts/run-mac.sh" ;;
      *) exec bash "$DIR/scripts/run-linux.sh" ;;
    esac ;;
  # git first, so a master hands off before the frontend goes, stopped through
  # reboots since compose restarts only unless-stopped
  stop\|)
    for c in hesperus-git hesperus hesperus-search; do
      [ "$($DOCKER inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" = true ] || continue
      echo "stopping $c..."
      $DOCKER stop -t 30 "$c" >/dev/null || exit 1
    done
    echo "hesperus stopped, hesperus start starts it again" ;;
  # git stopped first for the handoff, started again once hesperus is back
  restart\|)
    git_up="$($DOCKER inspect -f '{{.State.Running}}' hesperus-git 2>/dev/null)"
    [ "$git_up" = true ] && { echo "stopping hesperus-git..."; $DOCKER stop -t 30 hesperus-git >/dev/null || exit 1; }
    echo "restarting hesperus..."
    $DOCKER restart -t 30 hesperus >/dev/null || exit 1
    [ "$git_up" = true ] && { echo "starting hesperus-git..."; $DOCKER start hesperus-git >/dev/null || exit 1; }
    echo "hesperus restarted" ;;
  update\|) ask_password; exec bash "$DIR/scripts/update.sh" ;;
  update\|all) cli update-all ;;
  -h\|*|-help\|*|--help\|*|help\|*) usage ;;
  *) usage >&2; exit 2 ;;
esac
