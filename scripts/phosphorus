#!/bin/bash
# phosphorus: the cli with no args, else start / stop / restart / update, the cli
# in the phosphorus container, the host needing nothing past docker
set -uo pipefail

# through the /usr/local/bin symlink to the home
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src == /* ]] || src="$d/$src"
done
DIR="$(cd -P "$(dirname "$src")/.." && pwd)"

usage() {
  echo "usage: phos             the cli"
  echo "       phos start       start host"
  echo "       phos stop        stop host"
  echo "       phos restart     restart host"
  echo "       phos update      update host"
  echo "       phos update all  update mesh"
}

# installed on Linux: root's /var/lib/phosphorus
if [ "$(uname)" = Linux ] && [ "$(id -u)" != 0 ] && [ -n "${1:-}" ]; then
  exec sudo "$DIR/scripts/phosphorus" "$@"
fi

DOCKER=docker
[ "$(uname)" = Linux ] && ! docker info >/dev/null 2>&1 && DOCKER="sudo docker"

started() { $DOCKER inspect -f '{{.State.Running}} {{.State.StartedAt}}' phosphorus 2>/dev/null; }

# the binary's cli, node's on an image from before it
CLI='command -v phosphorus >/dev/null && exec phosphorus cli "$@"; exec node /opt/frontend/cli/phosphorus.js "$@"'

# a mesh update swaps this container out from under the cli: the new one
# waited for and reattached, on the same tab
cli() {
  local args=("$@") before code
  while :; do
    before="$(started)"
    if [ "${before%% *}" != true ]; then
      echo "phosphorus isn't running, run: phos start" >&2
      exit 1
    fi
    $DOCKER exec -it -e TERM="${TERM:-xterm-256color}" -e COLORTERM -e COLORFGBG -e TERM_PROGRAM phosphorus sh -c "$CLI" sh "${args[@]+"${args[@]}"}"
    code=$?
    [ "$(started)" = "$before" ] && exit "$code"
    echo "phosphorus is restarting, reattaching (ctrl-c to quit)..."
    until [ "$(started | cut -d' ' -f1)" = true ]; do sleep 1; done
    [ "${args[0]:-}" = update-all ] && args=(--tab update)
  done
}

# ADMIN_PASS from .env (PHOSPHORUS_UPDATE_PASSWORD before it), unset: open
ask_password() {
  local want got
  want="$(grep '^ADMIN_PASS=' "$DIR/.env" 2>/dev/null | cut -d= -f2-)"
  [ -n "$want" ] || want="$(grep '^PHOSPHORUS_UPDATE_PASSWORD=' "$DIR/.env" 2>/dev/null | cut -d= -f2-)"
  [ -n "$want" ] || return 0
  read -rsp "admin password: " got; echo
  [ "$got" = "$want" ] || { echo "wrong password" >&2; exit 1; }
}

# handed to the host's agent (systemd path unit, the app), its verdict waited on
request_update() {
  local id out="$DIR/state/update-agent.json" line last="" i
  id="cli-$(date +%s)-$$"
  mkdir -p "$DIR/state"
  printf '{"id":"%s","at":%s}\n' "$id" "$(date +%s)000" > "$DIR/state/update-request.json.tmp" \
    && mv "$DIR/state/update-request.json.tmp" "$DIR/state/update-request.json"
  echo "update requested, checking the release feed..."
  for i in $(seq 1 1800); do
    line="$(cat "$out" 2>/dev/null)"
    case "$line" in *"\"id\":\"$id\""*) ;; *) line="" ;; esac
    if [ -n "$line" ] && [ "$line" != "$last" ]; then
      last="$line"
      case "$line" in
        *'"state":"failed"'*) echo "update failed: $(sed -n 's/.*"error":"\([^"]*\)".*/\1/p' <<<"$line")" >&2; exit 1 ;;
        *'"current":true'*) echo "already up to date"; exit 0 ;;
        *'"state":"ok"'*) echo "updated to $(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' <<<"$line")"; exit 0 ;;
        *) echo "updating..." ;;
      esac
    fi
    [ "$i" = 30 ] && [ -z "$last" ] && echo "nothing picked it up yet: is the update agent running (Linux: phosphorus-update.path, else the Phosphorus app)?"
    sleep 1
  done
  echo "gave up waiting, see $out" >&2; exit 1
}

# reruns this command detached and follows its log: a terminal inside phosphorus
# (or an ssh over its tailnet) dropping mid-restart never leaves git stopped
detach() {
  local log="$DIR/state/$1.log" pid tailpid code
  mkdir -p "$DIR/state" && : > "$log"
  if command -v setsid >/dev/null 2>&1; then
    PHOSPHORUS_DETACHED=1 nohup setsid "$DIR/scripts/phosphorus" "$1" > "$log" 2>&1 < /dev/null &
  else
    PHOSPHORUS_DETACHED=1 nohup "$DIR/scripts/phosphorus" "$1" > "$log" 2>&1 < /dev/null &
  fi
  pid=$!
  tail -n +1 -f "$log" & tailpid=$!
  wait "$pid"; code=$?
  sleep 0.3; kill "$tailpid" 2>/dev/null
  exit "$code"
}

case "${1:-}|${2:-}" in
  "|") cli ;;
  start\|)
    case "$(uname)" in
      Darwin) exec bash "$DIR/scripts/run-mac.sh" ;;
      *) exec bash "$DIR/scripts/run-linux.sh" ;;
    esac ;;
  # git first, so a master hands off before the frontend goes, stopped through
  # reboots since compose restarts only unless-stopped
  stop\|)
    [ -n "${PHOSPHORUS_DETACHED:-}" ] || detach stop
    for c in phosphorus-git phosphorus phosphorus-model phosphorus-search; do
      [ "$($DOCKER inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" = true ] || continue
      echo "stopping $c..."
      $DOCKER stop -t 30 "$c" >/dev/null || exit 1
    done
    echo "phosphorus stopped, phos start to resume" ;;
  # git stopped first for the handoff, started again once phosphorus is back
  restart\|)
    [ -n "${PHOSPHORUS_DETACHED:-}" ] || detach restart
    git_up="$($DOCKER inspect -f '{{.State.Running}}' phosphorus-git 2>/dev/null)"
    [ "$git_up" = true ] && { echo "stopping phosphorus-git..."; $DOCKER stop -t 30 phosphorus-git >/dev/null || exit 1; }
    echo "restarting phosphorus..."
    rc=0
    $DOCKER restart -t 30 phosphorus >/dev/null || { echo "couldn't restart phosphorus" >&2; rc=1; }
    # git back whatever became of phosphorus, else it stays stopped
    if [ "$git_up" = true ]; then
      echo "starting phosphorus-git..."
      $DOCKER start phosphorus-git >/dev/null || { echo "couldn't start phosphorus-git" >&2; rc=1; }
    fi
    [ "$rc" = 0 ] && echo "phosphorus restarted"
    exit "$rc" ;;
  update\|) ask_password; request_update ;;
  update\|all) cli update-all ;;
  -h\|*|-help\|*|--help\|*|help\|*) usage ;;
  *) usage >&2; exit 2 ;;
esac
