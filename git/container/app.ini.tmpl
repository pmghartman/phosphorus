# rendered once by git-daemon.sh, sections added since appended there

APP_NAME = hesperus git
RUN_MODE = prod
RUN_USER = git

[server]
DOMAIN           = __GITHOST__
HTTP_ADDR        = 0.0.0.0
HTTP_PORT        = __PORT__
ROOT_URL         = __ROOT_URL__
DISABLE_SSH      = true
LFS_START_SERVER = true
# obj/ rsynced, forgejo's default data/ not
APP_DATA_PATH    = /var/lib/hesperus/git/obj

[database]
DB_TYPE = sqlite3
PATH    = /var/lib/hesperus/git/litefs/forgejo.db

# sessions riding litefs with the rest of the db
[session]
PROVIDER = db

# per-node and rebuildable, so never synced
[queue]
DATADIR = /var/lib/hesperus/git/state/queues

[indexer]
ISSUE_INDEXER_PATH = /var/lib/hesperus/git/state/indexers/issues.bleve
REPO_INDEXER_PATH  = /var/lib/hesperus/git/state/indexers/repos.bleve

[log]
ROOT_PATH = /var/lib/hesperus/git/state/log

[repository]
ROOT = /var/lib/hesperus/git/obj/forgejo-repositories

[lfs]
PATH = /var/lib/hesperus/git/obj/lfs

[picture]
AVATAR_UPLOAD_PATH      = /var/lib/hesperus/git/obj/avatars
REPOSITORY_AVATAR_UPLOAD_PATH = /var/lib/hesperus/git/obj/repo-avatars

[attachment]
PATH = /var/lib/hesperus/git/obj/attachments

[packages]
PATH = /var/lib/hesperus/git/obj/packages

[security]
INSTALL_LOCK = true

# every push leaving loose objects, repacked daily, servants getting it by rsync
[cron.git_gc_repos]
ENABLED  = true
SCHEDULE = @every 24h
