{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phosphorus",
  "version": "0.1.0",
  "identifier": "dev.phosphorus.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "payload/": "release/"
    },
    "externalBin": [
      "binaries/phosphorus-host"
    ],
    "category": "Utility",
    "shortDescription": "Run this machine as a phosphorus host",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
