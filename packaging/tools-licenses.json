    {
      "name": "Tailscale",
      "spdx": "BSD-3-Clause",
      "pin": ["packaging/tools.sh", "^TAILSCALE=(\\S+)"],
      "source": "https://github.com/tailscale/tailscale",
      "license": "https://raw.githubusercontent.com/tailscale/tailscale/v{v}/LICENSE"
    },
    {
      "name": "cloudflared",
      "spdx": "Apache-2.0",
      "pin": ["packaging/tools.sh", "^CLOUDFLARED=(\\S+)"],
      "source": "https://github.com/cloudflare/cloudflared",
      "license": "https://raw.githubusercontent.com/cloudflare/cloudflared/{v}/LICENSE"
    }
  ],
  "fetched": [
    {
      "name": "llama.cpp",
      "spdx": "MIT",
      "pin": ["packages/ai/tools/src/index.ts", "LlamaTag\\s*=\\s*\"([^\"]+)\""],
