[Unit]
Description=Phosphorus host
After=network-online.target phosphorus-tailscaled.service tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=PHOSPHORUS_HOME=/var/lib/phosphorus
ExecStart=/var/lib/phosphorus/bin/phosphorus run
Restart=always
RestartSec=5
# TERM to run alone, which stops git (hand-off), the model, the tunnel and the
# frontend in order; whatever is left killed after the timeout
KillMode=mixed
TimeoutStopSec=150
# the model's weights locked in ram
LimitMEMLOCK=infinity
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
