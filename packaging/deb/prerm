#!/bin/sh
# the agent and the service stopped before the files go, its services handing off first
set -e
[ "$1" = remove ] || exit 0
if [ -d /run/systemd/system ]; then
    systemctl disable --now phosphorus-update.path >/dev/null 2>&1 || true
    systemctl disable --now phosphorus.service >/dev/null 2>&1 || true
fi
exit 0
