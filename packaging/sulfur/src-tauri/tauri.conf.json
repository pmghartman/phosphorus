{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sulfur",
  "version": "0.1.0",
  "identifier": "dev.phosphorus.sulfur",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sulfur",
        "width": 1320,
        "height": 860,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Phosphorus",
    "category": "DeveloperTool",
    "shortDescription": "Sulfur, Phosphorus's code editor",
    "longDescription": "Sulfur, the code editor of a Phosphorus mesh, in a window of its own: projects on any of your machines, builds on their own toolchains, and the mesh's agents at work in the editor.",
    "copyright": "Apache License 2.0",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
