{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phosphorus Client",
  "version": "0.1.0",
  "identifier": "dev.phosphorus.client",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "category": "Utility",
    "shortDescription": "The phosphorus mesh in a window",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
