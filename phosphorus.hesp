hesperus 0.1

system phosphorus {
  subsystem apps {
    component host {
      src: "apps/host/**"
    }
    component tray {
      src: "apps/tray/**"
    }
    component web {
      src: "apps/web/**"
    }

    host -> tray: calls
  }
  subsystem packages {
    component ai {
      src: "packages/ai/**"
    }
    component chat {
      src: "packages/chat/**"
    }
    component core {
      src: "packages/core/**"
    }
    component home {
      src: "packages/home/**"
    }
    component host {
      src: "packages/host/**"
    }
    component mesh {
      src: "packages/mesh/**"
    }
    component net {
      src: "packages/net/**"
    }
    component server {
      src: "packages/server/**"
    }

    ai -> core: calls
    ai -> home: calls
    ai -> mesh: calls
    ai -> net: calls
    chat -> core: calls
    chat -> mesh: calls
    home -> core: calls
    home -> mesh: calls
    home -> net: calls
    host -> core: calls
    host -> mesh: calls
    host -> net: calls
    mesh -> ai: calls
    mesh -> core: calls
    mesh -> home: calls
    mesh -> net: calls
    net -> core: calls
    server -> ai: calls
    server -> chat: calls
    server -> core: calls
    server -> home: calls
    server -> host: calls
    server -> mesh: calls
    server -> net: calls
  }
  component scripts {
    src: "scripts/**"
  }
  ingress http "HTTP" {
    protocol: http
  }
  ingress ws "WebSocket" {
    protocol: ws
  }
  external api_tailscale_com "api.tailscale.com" {
    protocol: http
    host: "api.tailscale.com"
  }
  network unresolved "Unresolved targets"
  hardware filesystem "Filesystem"
  hardware processes "OS processes"

  apps.host -> packages.ai: calls
  apps.host -> packages.core: calls
  apps.host -> packages.host: calls
  apps.host -> packages.mesh: calls
  apps.host -> packages.server: calls
  apps.tray -> filesystem: io
  apps.tray -> packages.core: calls
  apps.tray -> packages.mesh: calls
  apps.tray -> processes: io
  apps.web -> http: http
  apps.web -> packages.core: calls
  apps.web -> unresolved: http {
    resolved: false
  }
  apps.web -> unresolved: ws {
    resolved: false
  }
  http -> apps.tray: http
  http -> packages.ai: http
  http -> packages.chat: http
  http -> packages.home: http
  http -> packages.mesh: http
  http -> packages.net: http
  http -> packages.server: http
  packages.ai -> filesystem: io
  packages.ai -> http: http
  packages.ai -> processes: io
  packages.ai -> unresolved: http {
    resolved: false
  }
  packages.chat -> filesystem: io
  packages.chat -> unresolved: http {
    resolved: false
  }
  packages.core -> filesystem: io
  packages.core -> processes: io
  packages.core -> unresolved: http {
    resolved: false
  }
  packages.home -> filesystem: io
  packages.home -> unresolved: http {
    resolved: false
  }
  packages.home -> ws: ws
  packages.host -> filesystem: io
  packages.host -> http: http
  packages.host -> processes: io
  packages.host -> unresolved: http {
    resolved: false
  }
  packages.mesh -> api_tailscale_com: http
  packages.mesh -> filesystem: io
  packages.mesh -> unresolved: http {
    resolved: false
  }
  packages.net -> http: http
  packages.net -> unresolved: http {
    resolved: false
  }
  packages.net -> unresolved: ws {
    resolved: false
  }
  packages.net -> ws: ws
  packages.server -> api_tailscale_com: http
  packages.server -> filesystem: io
  packages.server -> http: http
  packages.server -> processes: io
  packages.server -> unresolved: http {
    resolved: false
  }
  packages.server -> ws: ws
  scripts -> filesystem: io
  scripts -> packages.core: calls
  scripts -> packages.mesh: calls
  scripts -> processes: io
  scripts -> unresolved: http {
    resolved: false
  }
  ws -> packages.home: ws
  ws -> packages.net: ws
}
