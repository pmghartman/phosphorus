#!/bin/sh
# remove: the cli links; purge: containers, volumes and /var/lib/hesperus (git data, chat, shares)
set -e
case "$1" in
remove | purge)
    for l in hesperus hesp; do
        if [ "$(readlink /usr/local/bin/$l 2>/dev/null)" = /var/lib/hesperus/scripts/hesperus ]; then rm -f /usr/local/bin/$l; fi
    done
    rm -f /etc/ssh/ssh_config.d/hesperus.conf
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
    ;;
esac
if [ "$1" = purge ]; then
    docker rm -f hesperus-git hesperus hesperus-search hesperus-updater >/dev/null 2>&1 || true
    docker volume rm hesperus_tailscale-state hesperus-git-data hesperus-git-db hesperus-models >/dev/null 2>&1 || true
    rm -rf /var/lib/hesperus
fi
exit 0
