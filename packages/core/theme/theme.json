    "--online": "#81c995",
    "--offmesh": "#f28b82",
    "--warn": "#fdd663",
    "--tab-hover": "#35363a",
    "--shadow": "#0b0c0e",
    "--lift": "0 0 0 1px rgb(0 0 0 / 0.3), 0 6px 20px -10px rgb(0 0 0 / 0.6)",
    "--drop": "0 0 0 1px rgb(0 0 0 / 0.45), 0 8px 24px -6px rgb(0 0 0 / 0.5)",
    "--lift-sm": "0 1px 2px rgb(0 0 0 / 0.35)",
    "--teal": "#6fb3a8",
    "--sage": "#93ad7d",
