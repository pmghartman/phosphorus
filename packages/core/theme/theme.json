    "--shadow": "#cfd3d8",
    "--lift": "0 0 0 1px rgb(31 35 40 / 0.05), 0 6px 20px -10px rgb(31 35 40 / 0.18)",
    "--drop": "0 0 0 1px rgb(31 35 40 / 0.07), 0 8px 24px -6px rgb(31 35 40 / 0.16)",
    "--lift-sm": "0 1px 2px rgb(31 35 40 / 0.08)",
    "--teal": "#2f7f72",
    "--sage": "#577a3c",
