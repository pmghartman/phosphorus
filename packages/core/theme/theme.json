{
  "about": "phosphorus's one theme, the source for the desktop, terminals, the cli and the tray: cool neutral greys on chrome's dark mode scale with a purple accent; light and black each lay over dark; ide the code window's, in the page's own tokens",
  "dark": {
    "color-scheme": "dark",
    "--bg": "#202124",
    "--fg": "#e8eaed",
    "--muted": "#9aa0a6",
    "--accent": "#a78bfa",
    "--accent-2": "#e3b341",
