{
  "about": "phosphorus's one theme, the source for the desktop, terminals, the cli and the tray: light and black each lay over dark; ide the code window's, in the page's own tokens",
  "dark": {
    "color-scheme": "dark",
    "--bg": "#131316",
    "--fg": "#e6e6ea",
    "--muted": "#9b9ba5",
    "--accent": "#9f81cf",
    "--accent-2": "#ce8755",
    "--dim": "#6c6c76",
    "--glyph-purple": "#a371f7",
    "--glyph-orange": "#f0883e",
    "--border": "#29292f",
    "--card": "#1a1a1e",
    "--tabbar": "#0f0f12",
    "--online": "#3fb950",
    "--offmesh": "#f85149",
    "--warn": "#d29922",
    "--tab-hover": "#232328",
    "--shadow": "#070708",
    "--lift": "0 0 0 1px rgb(0 0 0 / 0.25), 0 10px 28px -14px rgb(0 0 0 / 0.7)",
    "--drop": "0 0 0 1px rgb(0 0 0 / 0.3), 0 10px 24px -8px rgb(0 0 0 / 0.5), 0 28px 60px -16px rgb(0 0 0 / 0.55)",
    "--lift-sm": "0 1px 2px rgb(0 0 0 / 0.3)",
    "--teal": "#6fb3a8",
    "--sage": "#93ad7d",
    "--sky": "#7fa0c9",
    "--rose": "#c98ba0",
    "--sand": "#c4ab78",
    "--mesh-self": "#b48cff",
    "--mesh-active": "#4fc98a",
    "--font": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, \"Helvetica Neue\", sans-serif",
    "--mono": "ui-monospace, SFMono-Regular, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
    "--desk": "#0e0e11",
    "--r-ctl": "4px",
    "--r-pop": "4px",
    "--r-card": "4px",
    "--r-win": "4px"
  },
  "light": {
    "color-scheme": "light",
    "--bg": "#ffffff",
    "--fg": "#1c1c21",
    "--muted": "#666671",
    "--accent": "#6a4bb0",
    "--accent-2": "#a65a1e",
    "--dim": "#9a9aa4",
    "--glyph-purple": "#7c4ddb",
    "--glyph-orange": "#c4621a",
    "--border": "#e2e2e7",
    "--card": "#f7f7f8",
    "--tabbar": "#f4f4f6",
    "--online": "#1a7f37",
    "--offmesh": "#cf222e",
    "--warn": "#9a6700",
    "--tab-hover": "#ededf0",
    "--shadow": "#d4d4da",
    "--lift": "0 0 0 1px rgb(24 24 27 / 0.04), 0 10px 28px -16px rgb(24 24 27 / 0.2)",
    "--drop": "0 0 0 1px rgb(24 24 27 / 0.05), 0 10px 24px -10px rgb(24 24 27 / 0.16), 0 28px 60px -18px rgb(24 24 27 / 0.2)",
    "--lift-sm": "0 1px 2px rgb(24 24 27 / 0.08)",
    "--teal": "#2f7f72",
    "--sage": "#577a3c",
    "--sky": "#3d6a9e",
    "--rose": "#a8506f",
    "--sand": "#8a6a2c",
    "--mesh-self": "#7a4fd6",
    "--mesh-active": "#2c9a5c",
    "--desk": "#eeeef1"
  },
  "black": {
    "--bg": "#000000",
    "--border": "#1c1c1c",
    "--card": "#0b0b0d",
    "--tabbar": "#000000",
    "--tab-hover": "#17171a",
    "--shadow": "#161616",
    "--lift": "0 0 0 1px rgb(255 255 255 / 0.015), 0 14px 30px -18px rgb(255 255 255 / 0.05)",
    "--drop": "0 0 0 1px rgb(255 255 255 / 0.03), 0 18px 40px -16px rgb(255 255 255 / 0.07)",
    "--lift-sm": "none",
    "--desk": "#000000"
  },
  "ide": {
    "--ide-bg": "var(--bg)",
    "--ide-side": "var(--tabbar)",
    "--ide-fg": "var(--fg)",
    "--ide-strong": "var(--fg)",
    "--ide-muted": "var(--muted)",
    "--ide-dim": "var(--dim)",
    "--ide-border": "var(--border)",
    "--ide-accent": "var(--accent)",
    "--ide-link": "var(--accent)",
    "--ide-hover": "color-mix(in srgb, var(--fg) 6%, transparent)",
    "--ide-sel": "color-mix(in srgb, var(--accent) 24%, transparent)",
    "--ide-sel-off": "color-mix(in srgb, var(--fg) 9%, transparent)",
    "--ide-input": "var(--card)",
    "--ide-input-border": "var(--border)",
    "--ide-button": "var(--accent)",
    "--ide-button-hover": "color-mix(in srgb, var(--accent) 85%, var(--fg))",
    "--ide-button-fg": "var(--bg)",
    "--ide-second": "var(--card)",
    "--ide-second-hover": "color-mix(in srgb, var(--fg) 10%, var(--card))",
    "--ide-second-fg": "var(--fg)",
    "--ide-widget": "var(--card)",
    "--ide-widget-border": "var(--border)",
    "--ide-badge": "var(--accent)",
    "--ide-badge-fg": "var(--bg)",
    "--ide-err": "var(--offmesh)",
    "--ide-warn": "var(--warn)",
    "--ide-info": "var(--sky)",
    "--ide-ok": "var(--online)",
    "--ide-hl": "var(--accent)",
    "--ide-find": "color-mix(in srgb, var(--accent-2) 32%, transparent)",
    "--ide-find-now": "color-mix(in srgb, var(--accent-2) 60%, transparent)",
    "--ide-guide": "var(--border)",
    "--ide-scroll": "color-mix(in srgb, var(--muted) 40%, transparent)",
    "--ide-shadow": "var(--drop)",
    "--ide-ed-sel": "color-mix(in srgb, var(--accent) 30%, var(--ide-bg))",
    "--ide-line-nr": "var(--dim)",
    "--ide-caret": "var(--accent)",
    "--ide-line-hl": "color-mix(in srgb, var(--fg) 4%, transparent)",
    "--ide-line-border": "transparent",
    "--ide-line-nr-now": "var(--fg)",
    "--ide-bracket": "color-mix(in srgb, var(--accent) 18%, transparent)",
    "--ide-bracket-border": "color-mix(in srgb, var(--accent) 60%, transparent)",
    "--ide-word-hl": "color-mix(in srgb, var(--fg) 12%, transparent)",
    "--ide-ruler": "var(--border)",
    "--hl-del": "var(--offmesh)",
    "--ide-ui": "var(--font)",
    "--hl-kw": "var(--accent)",
    "--hl-str": "var(--sage)",
    "--hl-num": "var(--sand)",
    "--hl-title": "var(--sky)",
    "--hl-type": "var(--teal)",
    "--hl-attr": "var(--rose)",
    "--hl-meta": "var(--accent-2)",
    "--hl-cmt": "var(--muted)",
    "--hl-cmt-style": "italic"
  }
}
