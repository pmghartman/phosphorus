{
  "about": "phosphorus's one theme, the source for the desktop, terminals, the cli and the tray: light and black each lay over dark; ide the code window's, in the page's own tokens",
  "dark": {
    "color-scheme": "dark",
    "--bg": "#1b1b23",
    "--fg": "#dcdce4",
    "--muted": "#9d9db0",
    "--accent": "#a78bfa",
    "--accent-2": "#d9915e",
    "--dim": "#6b6b7e",
    "--glyph-purple": "#a78bfa",
    "--glyph-orange": "#f0883e",
    "--border": "#2e2e3b",
    "--card": "#21212b",
    "--tabbar": "#16161d",
    "--online": "#4ade80",
    "--offmesh": "#f87171",
    "--warn": "#e0b04a",
    "--tab-hover": "#2b2b38",
    "--shadow": "#08080c",
    "--lift": "0 0 0 1px rgb(0 0 0 / 0.3), 0 6px 20px -10px rgb(0 0 0 / 0.6)",
    "--drop": "0 0 0 1px rgb(0 0 0 / 0.4), 0 8px 24px -6px rgb(0 0 0 / 0.5)",
    "--lift-sm": "0 1px 2px rgb(0 0 0 / 0.35)",
    "--teal": "#6fb3a8",
    "--sage": "#93ad7d",
    "--sky": "#7fa0c9",
    "--rose": "#c98ba0",
    "--sand": "#c4ab78",
    "--mesh-self": "#b79cff",
    "--mesh-active": "#4fd08f",
    "--font": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, \"Helvetica Neue\", sans-serif",
    "--mono": "ui-monospace, SFMono-Regular, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
    "--desk": "#121219",
    "--r-ctl": "4px",
    "--r-pop": "4px",
    "--r-card": "4px",
    "--r-win": "4px"
  },
  "light": {
    "color-scheme": "light",
    "--bg": "#fbfaf7",
    "--fg": "#262522",
    "--muted": "#6b6962",
    "--accent": "#6d4fc7",
    "--accent-2": "#b8622f",
    "--dim": "#9c998f",
    "--glyph-purple": "#7a52db",
    "--glyph-orange": "#c4621a",
    "--border": "#e2ded5",
    "--card": "#f3f1ec",
    "--tabbar": "#f0eee8",
    "--online": "#1f8a45",
    "--offmesh": "#cf3b3b",
    "--warn": "#9a6700",
    "--tab-hover": "#e8e5dd",
    "--shadow": "#d6d2c8",
    "--lift": "0 0 0 1px rgb(38 37 34 / 0.05), 0 6px 20px -10px rgb(38 37 34 / 0.18)",
    "--drop": "0 0 0 1px rgb(38 37 34 / 0.07), 0 8px 24px -6px rgb(38 37 34 / 0.16)",
    "--lift-sm": "0 1px 2px rgb(38 37 34 / 0.08)",
    "--teal": "#2f7f72",
    "--sage": "#577a3c",
    "--sky": "#3d6a9e",
    "--rose": "#a8506f",
    "--sand": "#8a6a2c",
    "--mesh-self": "#6d4fc7",
    "--mesh-active": "#2c9a5c",
    "--desk": "#e9e6df"
  },
  "black": {
    "--bg": "#000000",
    "--border": "#23232d",
    "--card": "#0d0d12",
    "--tabbar": "#000000",
    "--tab-hover": "#1a1a23",
    "--shadow": "#161616",
    "--lift": "0 0 0 1px rgb(255 255 255 / 0.04)",
    "--drop": "0 0 0 1px rgb(255 255 255 / 0.06), 0 8px 24px -6px rgb(0 0 0 / 0.8)",
    "--lift-sm": "none",
    "--desk": "#000000"
  },
  "ide": {
    "--ide-bg": "var(--bg)",
    "--ide-side": "var(--tabbar)",
    "--ide-fg": "var(--fg)",
    "--ide-strong": "var(--fg)",
    "--ide-muted": "var(--muted)",
    "--ide-dim": "var(--dim)",
    "--ide-border": "var(--border)",
    "--ide-accent": "var(--accent)",
    "--ide-link": "var(--accent)",
    "--ide-hover": "color-mix(in srgb, var(--fg) 6%, transparent)",
    "--ide-sel": "color-mix(in srgb, var(--accent) 24%, transparent)",
    "--ide-sel-off": "color-mix(in srgb, var(--fg) 9%, transparent)",
    "--ide-input": "var(--card)",
    "--ide-input-border": "var(--border)",
    "--ide-button": "var(--accent)",
    "--ide-button-hover": "color-mix(in srgb, var(--accent) 85%, var(--fg))",
    "--ide-button-fg": "var(--bg)",
    "--ide-second": "var(--card)",
    "--ide-second-hover": "color-mix(in srgb, var(--fg) 10%, var(--card))",
    "--ide-second-fg": "var(--fg)",
    "--ide-widget": "var(--card)",
    "--ide-widget-border": "var(--border)",
    "--ide-badge": "var(--accent)",
    "--ide-badge-fg": "var(--bg)",
    "--ide-err": "var(--offmesh)",
    "--ide-warn": "var(--warn)",
    "--ide-info": "var(--sky)",
    "--ide-ok": "var(--online)",
    "--ide-hl": "var(--accent)",
    "--ide-find": "color-mix(in srgb, var(--accent-2) 32%, transparent)",
    "--ide-find-now": "color-mix(in srgb, var(--accent-2) 60%, transparent)",
    "--ide-guide": "var(--border)",
    "--ide-scroll": "color-mix(in srgb, var(--muted) 40%, transparent)",
    "--ide-shadow": "var(--drop)",
    "--ide-ed-sel": "color-mix(in srgb, var(--accent) 30%, var(--ide-bg))",
    "--ide-line-nr": "var(--dim)",
    "--ide-caret": "var(--accent)",
    "--ide-line-hl": "color-mix(in srgb, var(--fg) 4%, transparent)",
    "--ide-line-border": "transparent",
    "--ide-line-nr-now": "var(--fg)",
    "--ide-bracket": "color-mix(in srgb, var(--accent) 18%, transparent)",
    "--ide-bracket-border": "color-mix(in srgb, var(--accent) 60%, transparent)",
    "--ide-word-hl": "color-mix(in srgb, var(--fg) 12%, transparent)",
    "--ide-ruler": "var(--border)",
    "--hl-del": "var(--offmesh)",
    "--ide-ui": "var(--font)",
    "--hl-kw": "var(--accent)",
    "--hl-str": "var(--sage)",
    "--hl-num": "var(--sand)",
    "--hl-title": "var(--sky)",
    "--hl-type": "var(--teal)",
    "--hl-attr": "var(--rose)",
    "--hl-meta": "var(--accent-2)",
    "--hl-cmt": "var(--muted)",
    "--hl-cmt-style": "italic"
  }
}
