    "--mesh-active": "#4fc98a",
    "--font": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, \"Helvetica Neue\", sans-serif",
    "--mono": "ui-monospace, SFMono-Regular, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
    "--desk": "#171819",
    "--r-ctl": "4px",
    "--r-pop": "4px",
    "--r-card": "4px",
    "--r-win": "4px"
  },
  "light": {
    "color-scheme": "light",
    "--bg": "#ffffff",
    "--fg": "#202124",
    "--muted": "#5f6368",
    "--accent": "#6d4fc7",
    "--accent-2": "#b06000",
    "--dim": "#80868b",
    "--glyph-purple": "#7a52db",
    "--glyph-orange": "#c4621a",
    "--border": "#dadce0",
    "--card": "#f8f9fa",
    "--tabbar": "#f1f3f4",
