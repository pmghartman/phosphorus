{
  "name": "phosphorus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*/*",
    "optional/*"
  ],
  "scripts": {
    "check": "bun scripts/deps.ts --check && tsc --noEmit -p .",
    "test": "bun scripts/test.ts",
    "web": "bun scripts/webbuild.ts",
    "build": "bun scripts/build.ts",
    "licenses": "bun scripts/licenses.ts",
    "icons": "bun scripts/icons.ts",
    "deps": "bun scripts/deps.ts",
    "app": "bun scripts/appbuild.ts",
    "fmt": "biome check --write .",
    "lint": "biome ci ."
  },
  "dependencies": {
    "@phosphorus/afterglow": "github:pmghartman/afterglow#v0.1",
    "@phosphorus/minisign": "workspace:*",
    "@phosphorus/theme": "workspace:*",
    "@phosphorus/tools": "workspace:*",
    "@phosphorus/webapps": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
