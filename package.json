{
  "name": "phosphorus",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*/*"
  ],
  "scripts": {
    "check": "bun scripts/deps.ts --check && tsc --noEmit -p .",
    "test": "bun scripts/test.ts",
    "web": "bun scripts/webbuild.ts",
    "build": "bun scripts/build.ts",
    "licenses": "bun scripts/licenses.ts",
    "deps": "bun scripts/deps.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "@phosphorus/minisign": "workspace:*",
    "@phosphorus/theme": "workspace:*"
  }
}
